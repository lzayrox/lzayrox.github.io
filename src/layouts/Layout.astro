---
import "../styles/global.css";
import particlesUrl from "particles.js?url";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
	title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>
			{title
				? `${title} | Humberto Llinás`
				: "Humberto Llinás | Software Engineering & Computational Modeling"}
		</title>
	</head>
	<body>
		<div id="particles-js" class="particle-background" aria-hidden="true"></div>
		<div class="page-content">
			<div id="top"></div>
			<Header />
			<main>
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<script is:inline src={particlesUrl}></script>

<script>
	if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const particlesJS = (
			window as typeof window & {
				particlesJS?: (id: string, options: Record<string, unknown>) => void;
			}
		).particlesJS;

		particlesJS?.("particles-js", {
			particles: {
				number: { value: 55, density: { enable: true, value_area: 900 } },
				color: { value: "#b7c878" },
				shape: { type: "circle" },
				opacity: { value: 0.55, random: true },
				size: { value: 3, random: true },
				line_linked: {
					enable: true,
					distance: 150,
					color: "#b7c878",
					opacity: 0.22,
					width: 1,
				},
				move: {
					enable: true,
					speed: 0.65,
					direction: "none",
					random: true,
					straight: false,
					out_mode: "out",
					bounce: false,
				},
			},
			interactivity: {
				detect_on: "window",
				events: {
					onhover: { enable: true, mode: "grab" },
					onclick: { enable: false },
					resize: true,
				},
				modes: {
					grab: {
						distance: 150,
						line_linked: { opacity: 0.45 },
					},
				},
			},
			retina_detect: true,
		});
	}
</script>

<script>
	const sections = document.querySelectorAll<HTMLElement>("[data-reveal-section]");
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	if (reduceMotion || !("IntersectionObserver" in window)) {
		sections.forEach((section) => section.classList.add("is-visible"));
	} else {
		let previousScrollY = window.scrollY;
		let scrollDirection: "up" | "down" = "down";
		const animationVersions = new WeakMap<Element, number>();

		window.addEventListener(
			"scroll",
			() => {
				const currentScrollY = window.scrollY;
				if (Math.abs(currentScrollY - previousScrollY) > 2) {
					scrollDirection = currentScrollY > previousScrollY ? "down" : "up";
					previousScrollY = currentScrollY;
				}
			},
			{ passive: true },
		);

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					const target = entry.target;
					const version = (animationVersions.get(target) ?? 0) + 1;
					animationVersions.set(target, version);
					const isInViewport = entry.isIntersecting && entry.intersectionRatio > 0;

					if (isInViewport) {
						target.classList.remove("is-leaving");
						target.classList.toggle("reveal-from-top", scrollDirection === "up");

						requestAnimationFrame(() => {
							requestAnimationFrame(() => {
								if (animationVersions.get(target) !== version) return;
								target.classList.add("is-visible");
							});
						});
					} else if (target.classList.contains("is-visible")) {
						target.classList.add("is-leaving");
						target.classList.toggle("reveal-from-top", scrollDirection === "down");

						requestAnimationFrame(() => {
							if (animationVersions.get(target) !== version) return;
							target.classList.remove("is-visible");
						});
					} else {
						target.classList.toggle(
							"reveal-from-top",
							entry.boundingClientRect.bottom <= 0,
						);
					}
				});
			},
			{ threshold: 0, rootMargin: "-20% 0px -10% 0px" },
		);

		sections.forEach((section) => observer.observe(section));
	}
</script>

<style>
	.particle-background {
		position: fixed;
		z-index: 0;
		inset: 0;
		background: linear-gradient(180deg, var(--color-surface), var(--color-bg));
		pointer-events: none;
	}

	.page-content {
		position: relative;
		z-index: 1;
	}
</style>
