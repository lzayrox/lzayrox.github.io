---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
	const caseStudies = await getCollection("caseStudies");

	return caseStudies.map((caseStudy) => ({
		params: { slug: caseStudy.id },
		props: { caseStudy },
	}));
}

const { caseStudy } = Astro.props as {
	caseStudy: CollectionEntry<"caseStudies">;
};
const { Content } = await render(caseStudy);
const { title, category, description, technologies, image, skills } =
	caseStudy.data;
---

<Layout title={title}>
	<article class="case-study">
		<a class="back-link" href="/#projects">← Back to projects</a>

		<header class="case-study__hero">
			<p>{category}</p>
			<h1>{title}</h1>
			<p class="case-study__description">{description}</p>

			<ul class="technologies" aria-label="Technologies used">
				{technologies.map((technology) => <li>{technology}</li>)}
			</ul>
		</header>

		{
			image && (
				<img
					class="case-study__image"
					src={image}
					alt={`${title} preview`}
				/>
			)
		}

		<div class="case-study__body">
			<div class="case-study__content">
				<Content />
			</div>

			<aside class="skills-evidence">
				<p class="skills-evidence__eyebrow">Skills demonstrated</p>
				{
					skills.map((skill) => (
						<section>
							<h2>{skill.name}</h2>
							<p>{skill.evidence}</p>
						</section>
					))
				}
			</aside>
		</div>
	</article>
</Layout>

<style>
	.case-study {
		width: min(calc(100% - 2rem), 1040px);
		margin: 0 auto;
		padding: 9rem var(--page-gutter) 5rem;
	}
	.back-link {
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		text-decoration: none;
	}
	.back-link:hover {
		color: var(--color-accent-hover);
	}
	.case-study__hero {
		max-width: 780px;
		margin: 3.5rem 0 4rem;
	}
	.case-study__hero > p:first-child,
	.skills-evidence__eyebrow {
		margin: 0 0 1rem;
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	h1 {
		margin: 0;
		font-size: clamp(3rem, 8vw, 6.5rem);
		font-weight: 500;
		letter-spacing: -0.06em;
		line-height: 0.94;
	}
	.case-study__description {
		max-width: 680px;
		margin: 2rem 0;
		color: var(--color-muted);
		font-size: 1.15rem;
		line-height: 1.7;
	}
	.technologies {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.technologies li {
		padding: 0.4rem 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}
	.case-study__image {
		display: block;
		width: 100%;
		margin-bottom: 4rem;
		border: 1px solid var(--color-border);
		border-radius: 4px;
	}
	.case-study__body {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 280px;
		gap: clamp(3rem, 8vw, 7rem);
	}
	.case-study__content :global(h2) {
		margin: 0 0 1.25rem;
		font-size: 1.5rem;
		font-weight: 500;
		letter-spacing: -0.02em;
	}
	.case-study__content :global(h2:not(:first-child)) {
		margin-top: 4rem;
	}
	.case-study__content :global(h3) {
		margin: 2.5rem 0 0.8rem;
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 1rem;
		font-weight: 500;
	}
	.case-study__content :global(p),
	.skills-evidence p {
		color: var(--color-muted);
		font-size: 1rem;
		line-height: 1.75;
	}
	.case-study__content :global(pre) {
		overflow-x: auto;
		margin: 2rem 0;
		padding: 1.25rem;
		border: 1px solid var(--color-border);
		background: color-mix(in srgb, var(--color-surface) 92%, black);
		font-size: 0.85rem;
	}
	.skills-evidence {
		align-self: start;
	}
	.skills-evidence section {
		padding: 1.25rem 0;
		border-top: 1px solid var(--color-border);
	}
	.skills-evidence h2 {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 500;
	}
	.skills-evidence p {
		margin: 0.75rem 0 0;
		font-size: 0.9rem;
	}
	@media (max-width: 800px) {
		.case-study {
			padding-top: 8rem;
		}
		.case-study__body {
			grid-template-columns: 1fr;
		}
		.skills-evidence {
			order: -1;
		}
	}
</style>
