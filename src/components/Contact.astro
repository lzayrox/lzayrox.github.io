---
import SectionContainer from "./SectionContainer.astro";
---

<SectionContainer id="contact" index="04" title="Contact" layout="split">

    <div class="contact-content">
        <p class="contact-title">
            Interested in software, simulation or computational modeling?
        </p>

        <p class="contact-description">
            Feel free to reach out if you'd like to discuss a project, research
            idea or collaboration.
        </p>

        <div class="contact-links">
            <a
                href="https://github.com/lzayrox"
                target="_blank"
                rel="noreferrer"
            >
                GitHub ↗
            </a>

            <a
                href="https://www.linkedin.com/in/humberto-llinas-jr-959a8220b/"
                target="_blank"
                rel="noreferrer"
            >
                LinkedIn ↗
            </a>

            <a href="mailto:humbertollinasjr@gmail.com"> Email ↗ </a>
        </div>
    </div>
</SectionContainer>

<style>
    .contact-content {
        max-width: 700px;
		padding: 6rem 0 6rem 4rem;
		border-left: 1px solid var(--color-border);
    }

    .contact-title {
        margin: 0;

        font-size: clamp(2.5rem, 5vw, 4.5rem);
        line-height: 1.05;
        letter-spacing: -0.04em;
    }

    .contact-description {
        max-width: 520px;

        margin: 2rem 0 0;

        font-size: 1.05rem;
        line-height: 1.7;

		color: var(--color-muted);
    }

    .contact-links {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;

        margin-top: 3rem;
    }

    .contact-links a {
        color: inherit;
        text-decoration: none;
        font-weight: 500;
    }

    .contact-links a:hover {
		color: var(--color-accent-hover);
    }

	.contact-links a {
		transition: color var(--transition);
	}

    @media (max-width: 768px) {
		.contact-content {
			padding: 2.5rem 0 4rem;
			border-top: 1px solid var(--color-border);
			border-left: 0;
		}

    }
</style>
