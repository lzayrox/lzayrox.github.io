<header class="header" data-header>
	<div class="header__inner">
		<a class="brand" href="/#top" aria-label="Humberto Llinás — ir al inicio">
			Humberto Llinás
		</a>

		<nav class="nav" aria-label="Navegación principal">
			<a href="/#about">About</a>
			<a href="/#projects">Projects</a>
			<a href="/#skills">Skills</a>
			<a href="/#contact">Contact</a>
		</nav>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>("[data-header]");
	const links = [...document.querySelectorAll<HTMLAnchorElement>(".nav a")];
	const sections = links
		.map((link) => document.querySelector<HTMLElement>(link.hash))
		.filter((section): section is HTMLElement => Boolean(section));

	const updateHeader = () => {
		header?.classList.toggle("header--scrolled", window.scrollY > 12);
		const activationLine = Math.max(
			(header?.getBoundingClientRect().height ?? 0) + 32,
			window.innerHeight * 0.4,
		);
		const current = sections.find((section) => {
			const { top, bottom } = section.getBoundingClientRect();
			return top <= activationLine && bottom > activationLine;
		});

		links.forEach((link) => {
			const isActive = current?.id === link.hash.slice(1);
			link.classList.toggle("is-active", isActive);
			if (isActive) link.setAttribute("aria-current", "location");
			else link.removeAttribute("aria-current");
		});
	};

	updateHeader();
	window.addEventListener("scroll", updateHeader, { passive: true });
	window.addEventListener("resize", updateHeader, { passive: true });
</script>

<style>
	.header {
		position: fixed;
		top: 0;
		right: 0;
		left: 0;
		z-index: 100;
		background: color-mix(in srgb, var(--color-bg) 28%, transparent);
		border-bottom: 1px solid color-mix(in srgb, var(--color-border) 52%, transparent);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		pointer-events: none;
		transition:
			background var(--transition),
			border-color var(--transition);
	}

	.header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(100%, var(--content-width));
		margin: 0 auto;
		padding: 1.25rem var(--page-gutter);
		pointer-events: auto;
	}

	.header--scrolled {
		background: color-mix(in srgb, var(--color-bg) 80%, transparent);
		border-color: color-mix(in srgb, var(--color-accent) 18%, var(--color-border));
	}

	.brand {
		flex: 0 0 auto;
		color: var(--color-text);
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		text-decoration: none;
		transition: color var(--transition);
	}

	.brand:hover { color: var(--color-accent-hover); }

	.nav {
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	.nav a {
		position: relative;
		color: var(--color-muted);
		font-size: 0.9rem;
		text-decoration: none;
		transition: color var(--transition);
	}

	.nav a:hover,
	.nav a.is-active {
		color: var(--color-accent-hover);
	}

	.nav a::after {
		position: absolute;
		bottom: -0.45rem;
		left: 0;
		width: 100%;
		height: 1px;
		background: var(--color-accent);
		content: "";
		opacity: 0;
		transform: scaleX(0);
		transform-origin: center;
		transition:
			transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
			opacity 120ms ease;
	}

	.nav a.is-active::after {
		opacity: 1;
		transform: scaleX(1);
	}

	@media (max-width: 680px) {
		.header {
			top: 0;
		}

		.header__inner {
			padding: 1rem var(--page-gutter);
		}

		.brand { font-size: 0.9rem; }
		.nav { gap: 0.8rem; }

		.nav a {
			font-size: clamp(0.68rem, 2.8vw, 0.8rem);
		}
	}

	@media (max-width: 460px) {
		.header__inner {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.9rem;
		}

		.nav {
			justify-content: space-between;
			width: 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.header,
		.brand,
		.nav a,
		.nav a::after { transition: none; }
	}
</style>
