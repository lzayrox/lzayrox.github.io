---
import SectionContainer from "./SectionContainer.astro";
---

<SectionContainer id="skills" index="03" title="Skills">

    <div class="skills-grid">
        <div class="skill-group">
            <h3>Software Development</h3>
            <p>C++ · Java · JavaScript / TypeScript · Python · R</p>
        </div>

        <div class="skill-group">
            <h3>Scientific Computing</h3>
            <p>Numerical Methods · Simulation · MPI · Computational Modeling</p>
        </div>

        <div class="skill-group">
            <h3>Machine Learning</h3>
            <p>
                Neural Networks · Optimization · Gradient Descent · Data
                Analysis
            </p>
        </div>

        <div class="skill-group">
            <h3>Tools & Infrastructure</h3>
            <p>Git · GitHub · Docker · Linux · GitHub Actions</p>
        </div>
    </div>
</SectionContainer>

<style>
    .skills-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);

		border-top: 1px solid var(--color-border);
    }

    .skill-group {
        padding: 3rem 2rem 3rem 0;

		border-bottom: 1px solid var(--color-border);
    }

    .skill-group:nth-child(odd) {
		border-right: 1px solid var(--color-border);
    }

    .skill-group:nth-child(even) {
        padding-left: 3rem;
    }

	.skill-group:nth-last-child(-n + 2) {
		border-bottom: 0;
	}

    h3 {
        margin: 0 0 1.5rem;

        font-size: clamp(1.5rem, 3vw, 2.3rem);
        font-weight: 500;
        letter-spacing: -0.02em;
    }

    .skill-group p {
        max-width: 480px;

        margin: 0;

        font-size: 1rem;
        line-height: 1.8;

		color: var(--color-muted);
    }

    @media (max-width: 768px) {
        .skills-grid {
            grid-template-columns: 1fr;
        }

        .skill-group,
        .skill-group:nth-child(even) {
            padding: 2.5rem 0;
            border-right: none;
			border-bottom: 1px solid var(--color-border);
        }

		.skill-group:last-child {
			border-bottom: 0;
		}
    }
</style>
