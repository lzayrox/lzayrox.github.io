---
import SectionContainer from "./SectionContainer.astro";
---

<SectionContainer id="about" index="01" title="About" layout="split">

  <div class="about-content">
    <p class="lead">
      I’m interested in building software to model,
      simulate and understand complex systems.
    </p>

    <p>
      My interests connect software engineering with
      computational modeling, scientific computing
      and machine learning.
    </p>

    <p>
      I enjoy exploring how algorithms, mathematical
      models and software can be combined to turn ideas
      into computational experiments.
    </p>
  </div>
</SectionContainer>

<style>
  .about-content {
    max-width: 650px;
	padding: 6rem 0 4.5rem 4rem;
	border-left: 1px solid var(--color-border);
  }

  .about-content p {
    margin: 0 0 1.5rem;

    font-size: 1.05rem;
    line-height: 1.7;

	color: var(--color-muted);
  }

  .about-content .lead {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.3;
    letter-spacing: -0.02em;

    opacity: 1;
  }

  @media (max-width: 768px) {
	.about-content {
		padding: 2.5rem 0 3rem;
		border-top: 1px solid var(--color-border);
		border-left: 0;
	}
  }

</style>
